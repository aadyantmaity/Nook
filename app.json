{
  "expo": {
    "name": "Nook",
    "slug": "Nook",
    "version": "1.0.0",
    "icon": "./assets/NookLogo.png",
    "scheme": "nook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/NookLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.aadyant.nook",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library so you can upload images of study spots."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/NookLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aadyant.nook"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "image": "./assets/NookLogo.png"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7038480c-4c12-4e56-bd2c-5a1dbe9b0cd3"
      }
    }
  }
}

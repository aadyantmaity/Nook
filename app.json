{
  "expo": {
    "name": "Nook",
    "slug": "nook",
    "version": "1.0.0",
    "icon": "./assets/NookLogo.png",
    "scheme": "nook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/NewNook.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.aadyant.nook",
      "buildNumber": "1.0.8",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library so you can upload images of study spots.",
        "NSUserNotificationUsageDescription": "We use notifications to remind you when your timer ends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/NookLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aadyant.nook"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "image": "./assets/NookLogo.png"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4fa00c32-f3ed-4ef5-ad72-b04ec4e10589"
      }
    },
    "owner": "aadyantmaity2"
  }
}
